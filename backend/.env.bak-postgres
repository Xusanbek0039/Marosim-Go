# ============================================================================
# MarosimGo backend — LOCAL development (.env is never committed)
# Format: KEY=value, no spaces around "=" or after commas.
# Production values: backend/.env.production.example, docs/DEPLOY.md
# ============================================================================

# ---------------------------------------------------------------- Django
# python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------- Database
# Local PostgreSQL 17 (service "postgresql-x64-17", role/db "marosimgo").
# SQLite fallback: DATABASE_URL=sqlite:///db.sqlite3
# Cache: unset = database table (created by migrate); Redis: CACHE_URL=redis://localhost:6379/0
DATABASE_URL=postgres://marosimgo:Xusanbek_0059@localhost:5432/marosimgo

# ---------------------------------------------------------------- JWT (a different secret from DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=change-me-too
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------- PINFL (JSHSHIR) protection
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Comma separated: the FIRST key encrypts, all keys decrypt (key rotation).
PINFL_ENCRYPTION_KEYS=tULE4mlVFRuGRXol0MJW0heKPnBLGliEBWMwtcN_FsU=
PINFL_HASH_KEY=another-long-random-secret

# ---------------------------------------------------------------- Web security
# Local panels run on Next.js (localhost:3000) and proxy /api/v1 to Django.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
NUM_PROXIES=1
USE_X_FORWARDED_HOST=true
USE_X_FORWARDED_PROTO=false
AUTH_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SERVE_MEDIA=true

# ---------------------------------------------------------------- Rate limits / login lockout
THROTTLE_LOGIN=5/min
THROTTLE_PINFL_REVEAL=20/hour
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# ---------------------------------------------------------------- Google Drive OAuth (personal Gmail)
# Root folder ID from https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=1uBCPiPrd8GdEGF8fJ4wxYdPr1Ls8dLSw
GOOGLE_OAUTH_CLIENT_ID=1022061897605-19q7nqrko9envgbhd5q6tf9a3g8ic0om.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/admin/storage/google/callback/

# Fernet key for the stored OAuth refresh tokens (rotated after an exposure)
GOOGLE_TOKEN_ENCRYPTION_KEY=TCK9mvDjUSwrc4oqYll75W53XgXo89DnnYgCZq46j5E=

# ---------------------------------------------------------------- Video watermark (ffmpeg)
MEDIA_WATERMARK_MAX_HEIGHT=720
MEDIA_WATERMARK_ENCODER=auto
MEDIA_WATERMARK_STREAM_SOURCE=true