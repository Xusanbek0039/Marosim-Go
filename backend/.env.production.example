# MarosimGo — production backend/.env for cPanel (copy to backend/.env and fill in).
# One Django app ("Setup Python App", startup file passenger_wsgi.py) answers every domain
# (step by step: docs/DEPLOY.md):
#   marosimgo.uz, www.       → landing page (backend/landing/)
#   api.marosimgo.uz         → API only (/api/v1/) — mobile apps
#   superadmin.marosimgo.uz  → Super Admin panel (backend/panel/)        + /api/v1/ on the same origin
#   admin.marosimgo.uz       → Admin panel       (backend/panel-admin/)  + /api/v1/ on the same origin
#   studio.marosimgo.uz      → Studio cabinet    (backend/panel-studio/) + /api/v1/ on the same origin
#
# FORMAT: KEY=value — no spaces around "=" and none after the commas. A line like
# "DJANGO_ALLOWED_HOSTS = a, b" is ignored ("Invalid line") and every request then fails with 400.

# python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=marosimgo.uz,www.marosimgo.uz,api.marosimgo.uz,superadmin.marosimgo.uz,admin.marosimgo.uz,studio.marosimgo.uz

# Each host gets its panel by its first label (superadmin./admin./studio.), api. gets none.
# Where Google Drive OAuth sends the browser back to:
PANEL_URL=https://superadmin.marosimgo.uz

# Shared cache for login lockout / throttling across worker processes. Default (unset): a table in
# the main database, created by `python manage.py migrate`. With Redis available:
# CACHE_URL=redis://127.0.0.1:6379/0

# Database: SQLite for now (file next to manage.py); later PostgreSQL / MySQL via DATABASE_URL
# DATABASE_URL=sqlite:////home/<cpanel-user>/marosimgo/backend/db.sqlite3

# JWT — a different secret from DJANGO_SECRET_KEY
JWT_SIGNING_KEY=

# PINFL — python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PINFL_ENCRYPTION_KEYS=
PINFL_HASH_KEY=

# HTTPS (cPanel AutoSSL / Let's Encrypt in front of Passenger)
AUTH_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
USE_X_FORWARDED_PROTO=True
# Turn on once HTTPS works on every subdomain (it cannot be undone quickly in browsers):
SECURE_HSTS_SECONDS=0

# The panels call /api/v1/ on their own origin; these lists cover forms and cross-site callers
CORS_ALLOWED_ORIGINS=https://superadmin.marosimgo.uz,https://admin.marosimgo.uz,https://studio.marosimgo.uz
CSRF_TRUSTED_ORIGINS=https://superadmin.marosimgo.uz,https://admin.marosimgo.uz,https://studio.marosimgo.uz
# The studio cabinet uploads videos straight to Google Drive from the browser
MEDIA_UPLOAD_BROWSER_ORIGINS=https://studio.marosimgo.uz

# Google Drive (Super Admin → Storage). Redirect URI must also be added in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://superadmin.marosimgo.uz/api/v1/admin/storage/google/callback/
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Video logo copies need ffmpeg. Shared cPanel hosting usually has none and kills background
# threads: then run `python manage.py process_watermarks --loop` on a machine/VPS with ffmpeg,
# or ask the host to install it.
MEDIA_WATERMARK_INLINE=True
MEDIA_WATERMARK_MAX_HEIGHT=720
MEDIA_WATERMARK_ENCODER=auto
