# ============================================================================
# MarosimGo — environment variables (example values only — NEVER commit real ones)
# Backend reads backend/.env, frontend reads frontend/.env.local
# ============================================================================

# ---------------------------------------------------------------- backend/.env
# python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite (default) — later switch to PostgreSQL:
# DATABASE_URL=postgres://marosimgo:password@localhost:5432/marosimgo
DATABASE_URL=sqlite:///db.sqlite3
# Shared cache is required for lockout/throttling with several workers, e.g. redis://localhost:6379/0
# CACHE_URL=locmemcache://marosimgo

# JWT — a different secret from DJANGO_SECRET_KEY
JWT_SIGNING_KEY=change-me-too
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7

# PINFL (JSHSHIR) protection
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Comma separated: the FIRST key encrypts, all keys decrypt (key rotation).
PINFL_ENCRYPTION_KEYS=generate-a-fernet-key
PINFL_HASH_KEY=another-long-random-secret

# Web security
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Behind the Next.js proxy (or nginx) set the number of trusted proxies
NUM_PROXIES=1
# Build absolute URLs with the panel host forwarded by the Next.js proxy
USE_X_FORWARDED_HOST=true
# Serve /media/ from Django (dev / small installs). Use nginx in production.
SERVE_MEDIA=true
AUTH_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_PROTO=false

# Rate limits
THROTTLE_LOGIN=5/min
THROTTLE_PINFL_REVEAL=20/hour
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# --------------------------------------------------------- frontend/.env.local
# Where the Next.js server proxies /api/v1 and /media (server-side only)
BACKEND_URL=http://127.0.0.1:8000
