DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3
# Shared cache is required for lockout/throttling with several workers, e.g. redis://localhost:6379/0
# CACHE_URL=locmemcache://marosimgo

# JWT — a different secret from DJANGO_SECRET_KEY
JWT_SIGNING_KEY=change-me-too
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7

# PINFL (JSHSHIR) protection
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Comma separated: the FIRST key encrypts, all keys decrypt (key rotation).
PINFL_ENCRYPTION_KEYS=generate-a-fernet-key
PINFL_HASH_KEY=another-long-random-secret

# Ceremony ownership & invitations (the same keys above encrypt invitation phone / JSHSHIR)
# OWNER access always needs an OTP-verified phone; keep true outside throwaway test databases.
CEREMONY_OWNER_REQUIRE_VERIFIED_PHONE=true
CEREMONY_INVITATION_TTL_DAYS=14
CEREMONY_MAX_PENDING_INVITATIONS=50
CEREMONY_MAX_INVITATION_SENDS=5

# Web security
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Behind the Next.js proxy (or nginx) set the number of trusted proxies
NUM_PROXIES=1
# Build absolute URLs with the panel host forwarded by the Next.js proxy
USE_X_FORWARDED_HOST=true
# Serve /media/ from Django (dev / small installs). Use nginx in production.
SERVE_MEDIA=true
AUTH_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_PROTO=false

# Rate limits
THROTTLE_LOGIN=5/min
THROTTLE_PINFL_REVEAL=20/hour
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
THROTTLE_REGISTER=10/hour

# Phone login (E.164). Comma separated ISO regions; the first one is the default.
PHONE_ALLOWED_REGIONS=UZ
# Optional anti-bot verifier for /auth/register/: dotted path to guard(request) -> bool
BOT_PROTECTION_GUARD=

# API monitoring (request metrics; no bodies, headers or tokens are stored)
MONITORING_ENABLED=true
MONITORING_ASYNC=true
MONITORING_RETENTION_DAYS=14
MONITORING_MAX_ROWS=2000000
# Base URL shown in the generated cURL / fetch / Python examples
PUBLIC_API_BASE_URL=http://localhost:8000

# Google Drive storage (Phase A) — see docs/GOOGLE_DRIVE_SETUP.md
# Fernet key for encrypting the Google refresh token (REQUIRED to connect Drive):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# OAuth client: by default read from backend/credentials/google_oauth_client.json (git-ignored).
# Set these two only to override the file (e.g. production secret manager):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/admin/storage/google/callback/
# Optional initial root folder (Phase B picks it in the panel)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Where the OAuth callback returns the browser (the Super Admin panel)
PANEL_URL=http://localhost:3000
THROTTLE_STORAGE_CONNECT=20/hour

# --------------------------------------------------------- frontend/.env.local
# Where the Next.js server proxies /api/v1 and /media (server-side only)
BACKEND_URL=http://127.0.0.1:8000
